# Copy to .env and fill in. Never commit .env.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

GOOGLE_CLIENT_ID=<google-oauth-client-id>

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>

# Email — verification codes, order emails, newsletter confirmations.
# Gmail: SMTP_PASS is a Google App Password (Google Account → Security →
# 2-Step Verification → App passwords), not the account password.
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-address@gmail.com>
SMTP_PASS=<google-app-password>
SMTP_FROM=<your-address@gmail.com>
FROM_NAME=BELOVI

# Optional alternative to SMTP, used only when SMTP_* is not set.
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# Local development only: print verification codes to the server console when
# no email provider is configured. Ignored when NODE_ENV=production.
OTP_CONSOLE_FALLBACK=false

# Optional — newsletter sync with Zoho Campaigns.
# ZOHO_DC=in
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_LIST_KEY=
