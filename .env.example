# Copy to .env and fill in. Never commit .env.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

GOOGLE_CLIENT_ID=<google-oauth-client-id>

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>

# Email — verification codes, order emails, newsletter confirmations.
# Exactly one provider sends each message: Resend if set, else SMTP, else SendGrid.
#
# Resend (preferred). FROM_EMAIL must be on a domain verified in Resend
# (Resend → Domains → add belovi.in, then add the DNS records it shows at your
# DNS host). A "Sending access" API key is enough and is the safer choice.
RESEND_API_KEY=<re_…>
FROM_EMAIL=no-reply@belovi.in
FROM_NAME=Belovi

# Optional SMTP alternative, used only when Resend is not configured.
# Gmail: SMTP_PASS is a Google App Password, not the account password.
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=<your-address@gmail.com>
# SMTP_PASS=<google-app-password>
# SMTP_FROM=<your-address@gmail.com>

# Optional alternative to SMTP, used only when SMTP_* is not set.
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# Local development only: print verification codes to the server console when
# no email provider is configured. Ignored when NODE_ENV=production.
OTP_CONSOLE_FALLBACK=false

# Optional — newsletter sync with Zoho Campaigns.
# ZOHO_DC=in
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_LIST_KEY=
